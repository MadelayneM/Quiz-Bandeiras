<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="409dp"
        android:layout_height="729dp">
        <TextView
            android:textSize="20sp"
            android:textColor="#f4ebeb"
            android:gravity="center"
            android:id="@+id/textView3"
            android:background="#4caf50"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Quiz Bandeiras"
            android:width="250dp"
            android:fontFamily="sans-serif-black"
            android:backgroundTint="#4caf50"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="35dp">

            <ImageView
                android:id="@+id/imgLucas"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_gravity="left"
                app:srcCompat="@drawable/adicionar_usuario" />
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="204dp"
                android:layout_height="match_parent"
                android:layout_weight="1">
                <TextView
                    android:textSize="20sp"
                    android:gravity="left"
                    android:id="@+id/txtNome1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="25dp"
                    android:text="Lucas Fonseca Shiraoka "
                    android:layout_marginStart="25dp"/>
                <TextView
                    android:textSize="20sp"
                    android:gravity="left"
                    android:id="@+id/txtRGM1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="RGM:37344471"
                    android:layout_marginStart="25dp"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp">
            <ImageView
                android:id="@+id/imgMadelayne"
                android:layout_width="100dp"
                android:layout_height="100dp"
                app:srcCompat="@drawable/mulher"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1">
                <TextView
                    android:textSize="20sp"
                    android:gravity="left"
                    android:id="@+id/txtNome2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="25dp"
                    android:text="Madelayne Mendoza Huanca "
                    android:layout_marginStart="25dp"/>
                <TextView
                    android:textSize="20sp"
                    android:gravity="left"
                    android:id="@+id/txtRGM2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="RGM:44386885"
                    android:layout_marginStart="25dp"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <EditText
                android:gravity="center"
                android:id="@+id/edtNome"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:hint="Digite seu nome:"
                android:ems="10"
                android:inputType="text"/>
            <LinearLayout
                android:gravity="bottom"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <Button
                    android:enabled="false"
                    android:textColorLink="#4caf50"
                    android:id="@+id/btnIniciar"
                    android:layout_width="185dp"
                    android:layout_height="wrap_content"
                    android:text="Iniciar"
                    android:backgroundTint="#4caf50"/>
                <Button
                    android:id="@+id/btnFinalizar"
                    android:layout_width="200dp"
                    android:layout_height="wrap_content"
                    android:text="Finalizar"
                    android:layout_marginStart="10dp"
                    android:backgroundTint="#4caf50"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>